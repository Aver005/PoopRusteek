# Copy to sandbox/.env and fill in. `.env` is git-ignored.
#
# Use a throwaway DeepSeek account: the harness drives the reverse-engineered
# web API automatically, which is exactly the traffic shape a provider is
# most likely to flag.
POOPRUSTEEK_TOKEN=

# Cargo profile for the image build. `dev` rebuilds much faster; `release`
# gives realistic timings.
BUILD_PROFILE=release

# Which mock-scripts/*.toml the `mock` service serves.
MOCK_SCRIPT=plain-answer.toml
CARGO_BUILD_JOBS=4
